ENV=development          # ohne ENV gilt production (fail closed)
SECRET_KEY=                 # >= 32 random chars
FIELD_ENCRYPTION_KEY=       # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATABASE_URL=postgresql+psycopg2://fanchat_app:fanchat_app@localhost:5432/fanchat
MIGRATION_DATABASE_URL=postgresql+psycopg2://owner:owner@localhost:5432/fanchat
APP_DB_PASSWORD=fanchat_app
LLM_PROVIDER=gemini         # gemini | fake
GEMINI_API_KEY_FILE=~/.secrets/gemini_api_key
AI_DISCLOSURE=🤖 KI-unterstützte Nachricht, von {model} freigegeben

# KI-Anbieter: gemini | anthropic | openai (jede OpenAI-kompatible API, z.B. OpenRouter) | fake (nur Tests)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=            # oder Datei ~/.secrets/anthropic_api_key
# ANTHROPIC_MODEL=claude-haiku-5-5
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-5-mini
